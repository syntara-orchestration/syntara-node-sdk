{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.syntara.io/v1alpha1/credential-recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "syntara.io/v1alpha1"},
    "kind": {"const": "CredentialRecipe"},
    "metadata": {"$ref": "common.schema.json#/$defs/targetMetadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "integrationType", "credentialSchema", "secretFields", "issuance"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/qualifiedIdentifier"},
        "integrationType": {"$ref": "common.schema.json#/$defs/qualifiedIdentifier"},
        "credentialSchema": {"$ref": "common.schema.json#/$defs/documentSource"},
        "secretFields": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/fieldIdentifier"}},
        "issuance": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "static-bearer.v1"}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "scopes", "pkce"], "properties": {"kind": {"const": "oauth2-authorization-code.v1"}, "scopes": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "pkce": {"const": true}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "audience"], "properties": {"kind": {"const": "jwt-token-exchange.v1"}, "audience": {"type": "string", "minLength": 1, "maxLength": 256}}}
          ]
        }
      }
    }
  }
}
