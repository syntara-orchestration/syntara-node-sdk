{
  "apiVersion": "syntara.io/v1alpha1",
  "kind": "CredentialRecipe",
  "metadata": {"name": "github-oauth", "displayName": "GitHub OAuth", "description": "Broker-interpreted GitHub OAuth recipe."},
  "spec": {
    "id": "syntara.github.oauth",
    "integrationType": "syntara.github.connection",
    "credentialSchema": {"kind": "inline", "value": {"type": "object", "properties": {"accessToken": {"type": "string"}, "refreshToken": {"type": "string"}}}},
    "secretFields": ["accessToken", "refreshToken"],
    "issuance": {"kind": "oauth2-authorization-code.v1", "scopes": ["repo", "read:user"], "pkce": true}
  }
}
